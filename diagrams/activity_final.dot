digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Создать заказ сотрудника\n(статус DRAFT)"];
n2 [label="Получить товар и количество", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n3 [label="Проверить: заказ не подтверждён, товар задан,\nid и наименование не пустые, цена > 0,\nколичество от 1 до 90"];
n4 [label="Позиция корректна", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
err [label="Выбросить исключение,\nзаказ не меняется", fillcolor="#FCE4D6", color="#C65911"];
n5 [label="Товар уже есть в заказе", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5a [label="Данные товара совпадают\nи сумма количеств <= 90", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6a [label="Увеличить количество\nсуществующей позиции"];
n6b [label="Добавить новую позицию"];
n7 [label="Есть ещё позиции", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n8 [label="Рассчитать итог:\nсумма getLineTotal по текущим позициям"];
n9 [label="Заказ не пуст и в статусе DRAFT", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n9a [label="Установить статус CONFIRMED"];
n9b [label="Выбросить IllegalStateException", fillcolor="#FCE4D6", color="#C65911"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> err [label="нет"];
n5 -> n5a [label="да"];
n5 -> n6b [label="нет"];
n5a -> n6a [label="да"];
n5a -> err [label="нет"];
n6a -> n7;
n6b -> n7;
err -> n7;
n7 -> n2 [label="да"];
n7 -> n8 [label="нет"];
n8 -> n9;
n9 -> n9a [label="да"];
n9 -> n9b [label="нет"];
n9a -> end;
n9b -> end;
}
